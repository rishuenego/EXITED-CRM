{
  "name": "exited-data-crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "init-users": "tsx scripts/init-users.ts",
    "test-db": "tsx -e \"import('./src/config/database.js').then(m => m.testConnection().then(r => { console.log('Result:', r); process.exit(r ? 0 : 1) }))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mysql2": "^3.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
